  m_Script: {fileID: 11500000, guid: f174459845c49dd479f0142013e8ca37, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::M3ItemInspector
  items:
  - itemID: m3_dao_mo
    displayName: "Dao m\u1ED5"
    description: "Con dao m\u1ED5 c\u1EE7a Clara, l\u1EA5y t\u1EEB h\u1ED9p k\u1EF7 v\u1EADt. Elias gi\u1EA5u n\xF3 trong tay \xE1o n\xEAn l\xEDnh g\xE1c l\u1EE5c so\xE1t kh\xF4ng t\xECm th\u1EA5y."
    usage: "R\u1EA1ch nh\u1EEFng th\u1EE9 b\u1ECB kh\xE2u k\xEDn hay che ph\u1EE7. Kh\xF4ng b\u1ECB m\u1EA5t sau khi d\xF9ng."
    image: {fileID: 21300000, guid: 541fc11fb2817084dbf14cbd2d6ddeea, type: 3}
  - itemID: m3_chia_khoa
    displayName: "Ch\xECa kh\xF3a \u0111\u1ED3ng"
    description: "Chi\u1EBFc ch\xECa nh\u1ECF gi\u1EA5u trong t\xFAi ng\u1EF1c \xE1o kho\xE1c c\u1EE7a s\u0129 quan tr\u1EF1c."
    usage: "V\u1EEBa v\u1EDBi m\u1ED9t \u1ED5 kh\xF3a nh\u1ECF... c\xF3 l\u1EBD c\u1EE7a m\u1ED9t ng\u0103n k\xE9o."
    image: {fileID: 21300000, guid: 20157975fcfd9894aa9b7955393bc694, type: 3}
  - itemID: m3_anh_gia_dinh
    displayName: "\u1EA2nh gia \u0111\xECnh"
    description: "Cha, m\u1EB9, Elias v\xE0 em trai ch\u1EE5p \u1EDF studio tr\u01B0\u1EDBc chi\u1EBFn tranh. L\u1EA7n cu\u1ED1i c\u1EA3 nh\xE0 c\xF2n b\xECnh y\xEAn \u2013 khi em trai c\xF2n c\u01B0\u1EDDi."
    usage: "M\u1ED9t k\xFD \u1EE9c qu\xFD gi\xE1. C\xF3 th\u1EE9 g\xEC \u0111\xF3 trong c\u0103n ph\xF2ng n\xE0y ph\u1EA3n \u1EE9ng v\u1EDBi k\xFD \u1EE9c c\u1EE7a Elias."
    image: {fileID: 21300000, guid: 5f01c48ac53f71e44a9103b38e605b4c, type: 3}
  - itemID: m3_kinh_lup
    displayName: "K\xEDnh l\xFAp"
    description: "K\xEDnh l\xFAp c\u1EE7a Elias, b\u1ECB t\u1ECBch thu c\xF9ng chi\u1EBFc v\xED."
    usage: "Soi nh\u1EEFng k\xFD hi\u1EC7u li ti m\xE0 m\u1EAFt th\u01B0\u1EDDng kh\xF4ng \u0111\u1ECDc \u0111\u01B0\u1EE3c."
    image: {fileID: 21300000, guid: 3a0154a05d4d6cc43ba862f50f1bd34c, type: 3}
  - itemID: m3_hiep_uoc
    displayName: "Hi\u1EC7p \u01B0\u1EDBc Thanh tr\u1EEBng"
    description: "V\u0103n b\u1EA3n \u0111\xF3ng d\u1EA5u \u0111\u1ECF, k\xFD t\xEAn T\u1ED5ng t\u01B0 l\u1EC7nh: k\u1EBF ho\u1EA1ch thanh tr\u1EEBng h\xE0ng ngh\xECn ng\u01B0\u1EDDi."
    usage: "Ph\u1EA3i ph\xE1 h\u1EE7y n\xF3. C\u1EA7n m\u1ED9t ng\u1ECDn l\u1EEDa."
    image: {fileID: 21300000, guid: 06929ae4b8f4f534dba03dd90a860379, type: 3}
