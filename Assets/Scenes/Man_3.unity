  roomManager: {fileID: 260392076}
  fader: {fileID: 1332533889}
  cameraToShake: {fileID: 0}
  greenFire: {fileID: 461104083}
  clock: {fileID: 1250423259}
  cracksToSpread:
  - {fileID: 444880281}
  - {fileID: 1651057993}
  doorClosed: {fileID: 1687822617}
  doorOpen: {fileID: 1260307738}
  brother: {fileID: 1854753709}
  brotherGun: {fileID: 448933571}
  brotherFallOffset: {x: 1.8, y: -3.3, z: 0}
  brotherFallAngle: -90
  windowShadow: {fileID: 735746185}
  muzzleFlash: {fileID: 2082108966}
  bloodPool: {fileID: 1267330895}
  scorpion: {fileID: 1671845237}
  crackTarget: {fileID: 1941455404}
  audioSource: {fileID: 1842899935}
  fireClip: {fileID: 0}
  rumbleClip: {fileID: 0}
  doorClip: {fileID: 0}
  gunshotClip: {fileID: 0}
  fireLine: "L\u1EEDa... m\xE0u xanh l\u1EE5c? Kh\xF4ng ph\u1EA3i l\u1EEDa b\xECnh th\u01B0\u1EDDng!"
  brotherLine: "Anh trai. Anh ngh\u0129 \u0111\u1ED1t m\u1ED9t t\u1EDD gi\u1EA5y l\xE0 x\xF3a \u0111\u01B0\u1EE3c t\u1EA5t c\u1EA3 nh\u1EEFng g\xEC ta \u0111\xE3 g\xE2y d\u1EF1ng sao?"
  eliasPleaLine: "Em... d\u1EEBng l\u1EA1i! \u0110\xE2y kh\xF4ng ph\u1EA3i con ng\u01B0\u1EDDi th\u1EADt c\u1EE7a em!"
  afterShotLine: "Ai... ai v\u1EEBa n\u1ED5 s\xFAng? Th\u1EE9 g\xEC v\u1EEBa chui v\xE0o khe n\u1EE9t kia?!"
  brotherSpeaker: Em trai
  loadNextLevel: 1
