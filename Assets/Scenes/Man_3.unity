  m_Script: {fileID: 11500000, guid: ade4bdc3818327d4593e6f4e30650fdb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::M3Journal
  objectiveText: {fileID: 1947557166}
  journalPanel: {fileID: 7684886}
  entriesText: {fileID: 455118280}
  newBadge: {fileID: 1882259217}
  objectives:
  - doneFlag: note_read
    requiresFlag: 
    text: "L\u1EE5c so\xE1t v\u0103n ph\xF2ng."
  - doneFlag: has_key
    requiresFlag: note_read
    text: "T\xECm ch\xECa kh\xF3a ng\u0103n k\xE9o \u2013 s\u0129 quan tr\u1EF1c \u0111ang gi\u1EEF n\xF3. \xC1o c\u1EE7a h\u1EAFn \u1EDF \u0111\xE2u nh\u1EC9?"
  - doneFlag: drawer_open
    requiresFlag: has_key
    text: "M\u1EDF ng\u0103n k\xE9o b\xE0n l\xE0m vi\u1EC7c, l\u1EA5y l\u1EA1i \u0111\u1ED3 b\u1ECB t\u1ECBch thu."
  - doneFlag: portrait_cut
    requiresFlag: 
    text: "B\u1EE9c ch\xE2n dung c\xF3 g\xEC \u0111\xF3 b\u1EA5t th\u01B0\u1EDDng... th\u1EE9 g\xEC n\u1EB1m sau l\u1EDBp v\u1EA3i?"
  - doneFlag: blood
    requiresFlag: 
    text: "Con m\u1EAFt ph\u1EA3n \u1EE9ng v\u1EDBi k\xFD \u1EE9c \u2013 cho n\xF3 xem th\u1EE9 g\u1EE3i nh\u1EDB gia \u0111\xECnh."
  - doneFlag: map_read
    requiresFlag: 
    text: "N\u0103m k\xFD hi\u1EC7u m\xE1u l\xE0 s\u1ED1 th\u1EE9 t\u1EF1. Th\u1EE9 g\xEC kh\xE1c trong ph\xF2ng c\u0169ng \u0111\u01B0\u1EE3c \u0111\xE1nh s\u1ED1 La M\xE3?"
  - doneFlag: safe_open
    requiresFlag: 
    text: "Gi\u1EA3i m\u1EADt m\xE3 k\xE9t s\u1EAFt 5 ch\u1EEF s\u1ED1 \u2013 xem l\u1EA1i s\u1ED5 tay."
  - doneFlag: burned
    requiresFlag: 
    text: "Ph\xE1 h\u1EE7y Hi\u1EC7p \u01B0\u1EDBc Thanh tr\u1EEBng \u2013 c\u1EA7n m\u1ED9t ng\u1ECDn l\u1EEDa."
  allDoneText: ...
